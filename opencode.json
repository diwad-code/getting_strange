{
  "$schema": "https://opencode.ai/config.json",
  "shell": "powershell",
  "snapshot": false,
  "instructions": [
    "AGENTS.md",
    "docs/WORKFLOW.md",
    "docs/TRAVERSAL_AND_OBSTACLE_DESIGN.md",
    "VISUAL_DESIGN.md",
    "docs/OPENCODE_SETUP.md"
  ],
  "watcher": {
    "ignore": [".godot/**", "reports/**", "snapshots/**", "dist/**", "*.log"]
  },
  "lsp": false,
  "permission": {
    "bash": {
      "*": "allow",
      "git": "deny",
      "git *": "deny",
      "gh": "deny",
      "gh *": "deny",
      "rm -rf *": "deny"
    },
    "edit": "allow",
    "skill": "allow",
    "external_directory": "ask"
  },
  "mcp": {
    "godot": {
      "type": "local",
      "command": ["npx", "-y", "godot-mcp-runtime"],
      "enabled": true,
      "environment": {
        "GODOT_PATH": "C:\\Users\\admin\\AppData\\Local\\Microsoft\\WinGet\\Packages\\GodotEngine.GodotEngine_Microsoft.Winget.Source_8wekyb3d8bbwe\\Godot_v4.7.2-stable_win64.exe",
        "GODOT_MCP_DISABLE_ELICITATION": "true"
      }
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    }
  }
}
